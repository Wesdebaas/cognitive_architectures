@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix am:  <http://example.org/awareness-manager#> .


am:set_table a dul:Goal ;
    am:requires am:breakfast_plate_present , am:cup_present .

am:breakfast_plate_present a am:Condition ; am:about am:breakfast_plate .
am:cup_present             a am:Condition ; am:about am:cup .
