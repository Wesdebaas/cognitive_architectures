@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix am:  <http://cognitive-nav.org/awareness-manager#> .


am:serve_guests a dul:Goal ;
    am:requires am:juice_present , am:juice_cold , am:wine_present , am:two_bottles_of_wine .

am:juice_present       a am:Condition ; am:about am:juice .
am:juice_cold          a am:Condition ; am:about am:juice .
am:wine_present        a am:Condition ; am:about am:wine .
am:two_bottles_of_wine a am:Condition ; am:about am:wine .
