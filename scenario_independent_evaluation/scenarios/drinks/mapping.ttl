@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix SOMA: <http://www.ease-crc.org/ont/SOMA.owl#> .
@prefix am:   <http://example.org/awareness-manager#> .


# The word a thing is known by in the commonsense source.
am:word a owl:DatatypeProperty .


# The things in this scenario.

am:juice a SOMA:Bottle ;                 # SOMA has no juice container
    am:word "juice" .

am:wine a SOMA:WineBottle ;
    am:word "wine" .

am:milk a SOMA:MilkBottle ;
    am:word "milk" .

am:bread a SOMA:Bread ;
    am:word "bread" .

am:plate a SOMA:Plate ;
    am:word "plate" .

am:cup a SOMA:Cup ;
    am:word "cup" .

am:knife a SOMA:Knife ;
    am:word "knife" .

am:cereal a SOMA:CerealBox ;
    am:word "cereal" .

am:refrigerator_1 a SOMA:Refrigerator ;
    am:word "refrigerator" .

am:bar_1 a SOMA:Cupboard ;                 # SOMA has no bar
    am:word "bar" .

am:dishwasher_1 a SOMA:Dishwasher ;
    am:word "dishwasher" .

am:oven_1 a SOMA:Oven ;
    am:word "oven" .

am:drawer_1 a SOMA:Drawer ;
    am:word "drawer" .

am:sink_1 a SOMA:Sink ;
    am:word "sink" .

am:table_1 a SOMA:Table ;
    am:word "table" .

am:trash_can_1 a SOMA:TrashContainer ;
    am:word "trash_can" .
