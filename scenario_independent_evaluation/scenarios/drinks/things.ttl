@prefix cn: <http://cognitive-nav.org/ontology#> .


# The places where the robot can look.
cn:refrigerator_1 a cn:Place .
cn:bar_1          a cn:Place .
cn:dishwasher_1   a cn:Place .
cn:oven_1         a cn:Place .
cn:drawer_1       a cn:Place .
cn:sink_1         a cn:Place .
cn:table_1        a cn:Place .
cn:trash_can_1    a cn:Place .

# The items in the scenario.
cn:juice  a cn:Item .
cn:wine   a cn:Item .
cn:milk   a cn:Item .
cn:bread  a cn:Item .
cn:plate  a cn:Item .
cn:cup    a cn:Item .
cn:knife  a cn:Item .
cn:cereal a cn:Item .
